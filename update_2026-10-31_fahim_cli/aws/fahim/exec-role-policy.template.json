{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StudioReadOnly",
      "Effect": "Allow",
      "Action": ["sagemaker:List*", "sagemaker:Describe*", "sagemaker:Get*", "sagemaker:Search"],
      "Resource": "*"
    },
    {
      "Sid": "OpenOwnStudio",
      "Effect": "Allow",
      "Action": "sagemaker:CreatePresignedDomainUrl",
      "Resource": "arn:aws:sagemaker:ap-southeast-1:<ACCOUNT_ID>:user-profile/d-ftva2wtce0s1/fahim"
    },
    {
      "Sid": "TagOnCreate",
      "Effect": "Allow",
      "Action": "sagemaker:AddTags",
      "Resource": "arn:aws:sagemaker:ap-southeast-1:<ACCOUNT_ID>:*/*",
      "Condition": { "Null": { "sagemaker:TaggingAction": "false" } }
    },
    {
      "Sid": "OwnPrivateSpacesOnly",
      "Effect": "Allow",
      "Action": ["sagemaker:CreateSpace", "sagemaker:UpdateSpace", "sagemaker:DeleteSpace"],
      "Resource": "arn:aws:sagemaker:ap-southeast-1:<ACCOUNT_ID>:space/d-ftva2wtce0s1/*",
      "Condition": {
        "ArnLike": { "sagemaker:OwnerUserProfileArn": "arn:aws:sagemaker:ap-southeast-1:<ACCOUNT_ID>:user-profile/d-ftva2wtce0s1/fahim" },
        "StringEquals": { "sagemaker:SpaceSharingType": "Private" }
      }
    },
    {
      "Sid": "OwnPrivateSpaceApps",
      "Effect": "Allow",
      "Action": ["sagemaker:CreateApp", "sagemaker:DeleteApp"],
      "Resource": "arn:aws:sagemaker:ap-southeast-1:<ACCOUNT_ID>:app/d-ftva2wtce0s1/*",
      "Condition": {
        "ArnLike": { "sagemaker:OwnerUserProfileArn": "arn:aws:sagemaker:ap-southeast-1:<ACCOUNT_ID>:user-profile/d-ftva2wtce0s1/fahim" },
        "StringEquals": { "sagemaker:SpaceSharingType": "Private" }
      }
    },
    {
      "Sid": "OnlyT3MediumToXlarge",
      "Effect": "Deny",
      "Action": ["sagemaker:CreateApp", "sagemaker:CreateSpace", "sagemaker:UpdateSpace"],
      "Resource": "*",
      "Condition": {
        "ForAnyValue:StringNotLike": { "sagemaker:InstanceTypes": ["ml.t3.medium", "ml.t3.large", "ml.t3.xlarge", "system"] }
      }
    },
    {
      "Sid": "ProjectBucketList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions", "s3:GetBucketLocation", "s3:ListBucketMultipartUploads"],
      "Resource": "arn:aws:s3:::inns-elec3544-dsfm-sagemaker"
    },
    {
      "Sid": "ProjectBucketObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:DeleteObject",
                 "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": "arn:aws:s3:::inns-elec3544-dsfm-sagemaker/*"
    },
    {
      "Sid": "KeepOldVersionsAndBucketSettings",
      "Effect": "Deny",
      "Action": ["s3:DeleteObjectVersion", "s3:DeleteBucket", "s3:PutBucket*", "s3:DeleteBucket*",
                 "s3:PutLifecycleConfiguration", "s3:PutEncryptionConfiguration", "s3:PutObjectAcl",
                 "s3:PutObjectVersionAcl"],
      "Resource": ["arn:aws:s3:::inns-elec3544-dsfm-sagemaker", "arn:aws:s3:::inns-elec3544-dsfm-sagemaker/*"]
    },
    {
      "Sid": "StudioLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents",
                 "logs:DescribeLogStreams", "logs:GetLogEvents"],
      "Resource": "arn:aws:logs:ap-southeast-1:<ACCOUNT_ID>:log-group:/aws/sagemaker/*"
    }
  ]
}
